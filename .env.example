# ─── RS Online / SIRS Kemenkes ────────────────────────────────────────────────
# Kredensial didapat dari Kemenkes (RS Online). JANGAN pernah commit file .env.
RS_ID=
RS_PASS=
BASE_URL=https://sirs.kemkes.go.id/fo/index.php/Fasyankes

# ─── Database SIMRS (MySQL/MariaDB) ───────────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# ─── Aplikasi ─────────────────────────────────────────────────────────────────
APP_TZ=Asia/Jakarta
# true = tampilkan error PHP di browser (hanya untuk development)
APP_DEBUG=false
# Web UI hanya boleh diakses dari localhost. Ubah ke true hanya jika sudah
# dilindungi (VPN / reverse proxy dengan autentikasi).
ALLOW_REMOTE=false

# ─── TLS ──────────────────────────────────────────────────────────────────────
# Verifikasi sertifikat SSL. Matikan (false) hanya jika terpaksa karena rantai
# sertifikat di server lokal bermasalah; lebih baik isi CURL_CAINFO.
CURL_VERIFY_SSL=true
# Path ke bundle CA, contoh Windows XAMPP: C:\xampp\php\extras\ssl\cacert.pem
CURL_CAINFO=
